# Copia este archivo a .env y completa los valores. NUNCA subas .env a Git.

# Base de datos (PostgreSQL)
POSTGRES_USER=trazabilidad
POSTGRES_PASSWORD=cambia_esto
POSTGRES_DB=trazabilidad
# Para correr la API fuera de Docker. En Docker, docker-compose usa el host "db".
DATABASE_URL=postgresql://trazabilidad:cambia_esto@localhost:5432/trazabilidad?schema=public

# Autenticación
JWT_ACCESS_SECRET=cambia_esto_por_un_valor_largo_aleatorio
JWT_REFRESH_SECRET=cambia_esto_por_otro_valor_largo_aleatorio

# Archivos (MinIO en desarrollo, DigitalOcean Spaces en producción)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=trazabilidad
S3_ACCESS_KEY=cambia_esto
S3_SECRET_KEY=cambia_esto

# Correo para recuperación de contraseña
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# URLs y CORS
PORT=3000
APP_URL=http://localhost:8081
PWA_URL=http://localhost:8082
CORS_ORIGINS=http://localhost:8081,http://localhost:8082

# Solo para producción: dominio base (ej. ejemplo.com) para Caddy
DOMINIO=
